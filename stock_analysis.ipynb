import pandas as pd
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
from sklearn.metrics import r2_score


# Create dataset
data = {
    "month": ["Jan", "Feb", "Mar", "Apr", "May", "Jun"],
    "market_return": [0.02, 0.01, -0.03, 0.04, 0.05, -0.01],
    "stock_return": [0.03, 0.015, -0.02, 0.06, 0.07, -0.005]
}

df = pd.DataFrame(data)


# Exploratory analysis
print(df.describe())


# Visualization
plt.plot(df["month"], df["stock_return"])
plt.xlabel("Month")
plt.ylabel("Stock Return")
plt.title("Stock Return Over Time")
plt.show()


# CAPM Regression
X = df[["market_return"]]
y = df["stock_return"]

model = LinearRegression()
model.fit(X, y)


# Results
print("Beta:", model.coef_[0])
print("Alpha:", model.intercept_)


prediction = model.predict(X)

print("R2 Score:", r2_score(y, prediction))
